{
    "name": "leandroperez/error-advisor",
    "description": "Framework-agnostic PHP 8.3+ error & stack-trace analyzer that diagnoses common PHP, SQL, HTTP/cURL, WordPress, Composer, and Git errors with actionable fixes.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "error-handler",
        "debugger",
        "stack-trace",
        "diagnostics",
        "troubleshooting",
        "developer-tools"
    ],
    "authors": [
        {
            "name": "Leandro Perez"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "suggest": {
        "ext-curl": "Required only if using GeminiErrorExplainer for AI-assisted fallback diagnosis."
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "LeandroPerez\\ErrorAdvisor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeandroPerez\\ErrorAdvisor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse src tests --level=8 --debug",
        "cs-check": "php-cs-fixer fix --dry-run --diff --sequential",
        "cs-fix": "php-cs-fixer fix --sequential"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}